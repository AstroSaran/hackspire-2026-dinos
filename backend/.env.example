# Kavach — environment configuration (Part 6 / Part 30)

# Weather provider selection: imd | open_meteo
WEATHER_PROVIDER=imd
WEATHER_ENABLE_FALLBACK=true

WEATHER_COUNTRY=India
WEATHER_STATE=West Bengal
TIMEZONE=Asia/Kolkata

# Caching (seconds) — do not hammer external APIs on every UI refresh
WEATHER_CACHE_TTL_CURRENT_S=600
WEATHER_CACHE_TTL_FORECAST_S=3600
WEATHER_CACHE_TTL_WARNINGS_S=300
WEATHER_STALE_AFTER_S=1800

# IMD requires IP whitelisting by its nodal officer before its endpoints
# will respond (see mausam.imd.gov.in/responsive/apis.php). Once approved,
# IMD station/district IDs must be added per-village in
# backend/app/geography.py (DISTRICTS[...]["imd_district_id"], and a
# per-village imd_station_id) — this build deliberately leaves them unset
# rather than guess values, per Part 4/Part 38.
