# Kavach — environment configuration
# Never commit a real .env with actual secrets. This file holds placeholders only.

# --- Weather provider priority (Part 3/12) ---
# 1. IMD (only attempted if IMD_ENABLED=true)
# 2. Open-Meteo (the immediate real-data source — public, keyless, always available as fallback)
# The live-only beta never displays a demo fallback.
IMD_ENABLED=false
IMD_API_KEY=
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
# ^ IMD's endpoints require IP whitelisting by IMD's nodal officer before they
#   respond (see mausam.imd.gov.in/responsive/apis.php). There is no API key
#   in the conventional sense to "activate" it — the current, official
#   mechanism is: (1) apply for IP whitelisting through IMD's nodal officer,
#   (2) once whitelisted, no key/token is required, requests from the
#   whitelisted IP succeed. IMD_API_KEY is reserved here in case that changes;
#   do not invent a bearer-token flow that doesn't exist.

WEATHER_ENABLE_FALLBACK=true
WEATHER_DEMO_FALLBACK=false

WEATHER_COUNTRY=India
WEATHER_STATE=West Bengal
TIMEZONE=Asia/Kolkata

# --- Caching (Part 21) ---
WEATHER_CACHE_TTL_CURRENT_S=600
WEATHER_CACHE_TTL_FORECAST_S=3600
WEATHER_CACHE_TTL_WARNINGS_S=300
WEATHER_STALE_AFTER_S=1800

# --- Historical rainfall baseline (Part 8/9/10) ---
# India OGD's official IMD district-normal-rainfall dataset
# (www.data.gov.in/catalog/rainfall) requires a free data.gov.in API key.
# Not wired up in this build without one — get a key at https://data.gov.in
# and see backend/app/weather/historical.py.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_MGNREGA_API_KEY=
DATA_GOV_IN_MARKET_RESOURCE_ID=
# This known public resource is a historical snapshot (01 Apr–31 Aug 2023),
# not a current employment feed. Replace it only with a verified current UUID.
DATA_GOV_IN_MGNREGA_RESOURCE_ID=ee03643a-ee4c-48c2-ac30-9f2ff26ab722
DATA_GOV_IN_CROP_RESOURCE_ID=35be999b-0208-4354-b557-f6ca9a5355de
# Optional AGMARKNET daily-price resource UUID from the official data.gov.in page.
# Market/employment aggregates remain unavailable until the key and each
# corresponding official resource UUID are set.

# --- Optional AI support assistant ---
GEMINI_API_KEY=
GEMINI_SUPPORT_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Verify both configured Gemini model IDs in Google AI Studio before a demo.
# Optional fallback when Gemini is not configured:
OPENAI_API_KEY=
KAVACH_SUPPORT_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
KAVACH_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
KAVACH_DAILY_AI_LIMIT=300
KAVACH_MAX_AI_CONCURRENCY=4

# Optional private accounts and encrypted notes (leave blank until configured)
MONGODB_URI=
MONGODB_DB_NAME=kavach
JWT_SECRET=
ENCRYPTION_KEY=

# --- Testing (Part 19) ---
# Real-network integration tests are skipped by default. Opt in only in an
# environment with genuine internet egress to api.open-meteo.com:
KAVACH_RUN_LIVE_INTEGRATION_TESTS=false
